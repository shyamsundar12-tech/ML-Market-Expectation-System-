import numpy as np

data["Daily Return"] = data["Close"].pct_change()
daily_return = data["Daily Return"].dropna()

skewness = daily_return.skew()

if abs(skewness) < 0.5:
    distribution = "Approximately Normal"

elif skewness > 0.5:
    distribution = "Positively Skewed"

else:
    distribution = "Negatively Skewed"

expected_value = daily_return.mean()

expected_percent = expected_value * 100

if expected_percent > 0:
    expected_text = f"+{expected_percent:.2f}%"

elif expected_percent < 0:
    expected_text = f"{expected_percent:.2f}%"

else:
    expected_text = "0.00%"

positive_days = (daily_return > 0).sum()
negative_days = (daily_return < 0).sum()
total_days = len(daily_return)
positive_probability = (positive_days / total_days) * 100
negative_probability = (negative_days / total_days) * 100

volatility = daily_return.std() * 100

if volatility < 1:
    volatility_level = "Low"

elif volatility < 2:
    volatility_level = "Medium"

else:
    volatility_level = "High"


if volatility < 1:
    risk = "Low"

elif volatility < 2:
    risk = "Medium"

else:
    risk = "High"

correlation = data["Close"].corr(data["Volume"])

if correlation > 0.70:
    correlation_text = "Strong Positive"

elif correlation > 0.30:
    correlation_text = "Moderate Positive"

elif correlation > -0.30:
    correlation_text = "Weak / No Correlation"

elif correlation > -0.70:
    correlation_text = "Moderate Negative"

else:
    correlation_text = "Strong Negative"

if expected_value > 0 and risk == "Low":
    outlook = "Healthy Growth Potential"

elif expected_value > 0 and risk == "Medium":
    outlook = "Moderate Growth Potential"

elif expected_value > 0 and risk == "High":
    outlook = "Growth With High Risk"

elif expected_value < 0 and risk == "High":
    outlook = "Higher Downside Risk"

else:
    outlook = "Neutral Market"

st.markdown("---")
st.markdown("## Market Expectation Analysis")

col1, col2 = st.columns(2)

with col1:

    st.metric(
